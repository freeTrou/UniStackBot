<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unistackbot_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo 集成层: world + Fortress 链 launch, 纯集成胶水零 C++; gz 适配器(sim_control_gz_node)由本包 launch 拉起、实现在 unistackbot_sim_control。</description>
  <maintainer email="todo@todo.todo">UniStackBot</maintainer>
  <license>TODO: Declaration of license</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- gz 后端适配器 (本包编译): /sim_control 契约 + 类型包 -->
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>unistackbot_interface</depend>
  <depend>unistackbot_sim_control</depend>
  <depend>ros_gz_interfaces</depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>unistackbot_description</exec_depend>
  <exec_depend>unistackbot_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
