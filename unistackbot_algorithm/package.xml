<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unistackbot_algorithm</name>
  <version>0.1.0</version>
  <description>纯算法库（2026-09-17 自 unistackbot_controller 拆出）：形态盲运动学解算（URDF→FK/雅可比）+ 数值 IK + 种子库工具链。零控制器生态依赖，可独立复用。</description>
  <maintainer email="todo@todo.todo">UniStackBot</maintainer>
  <license>TODO: Declaration of license</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>orocos_kdl_vendor</depend>
  <depend>orocos_kdl</depend>
  <depend>urdf</depend>
  <depend>urdfdom</depend>
  <depend>kdl_parser</depend>
  <depend>eigen</depend>
  <depend>unistackbot_interface</depend>
  <!-- vendored trac_ik 上游特例 (2026-10-08 用户裁决: 上游代码不剥离, 依赖如实声明;
       仅 trac_ik_solver/ 消费, dls_ik/urdf_fk/analytic_piper 仍零 ROS) -->
  <depend>rclcpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
