<mujoco_inputs>

  <!-- r1_pro URDF→MJCF 转换定制输入 (2026-10-14 程序化生成)
       限位/ctrlrange 全部提取自 original/urdf/r1pro_2026.urdf
       kp 为起步值 (参照 r1_7a 谱系: 腰/肩重载高, 腕末梢低), 首跑后按跟踪调
       无 mimic (r1_pro 夹爪双指是独立 prismatic, 非 mimic) -->

  <raw_inputs>
    <option integrator="implicitfast"/>

    <default>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
      </default>
    </default>

    <actuator>
