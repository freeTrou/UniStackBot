<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- r1_pro ros2_control 块 (官方 2026 g1z 提取): 单块 18 关节 (双臂 14 + 腰 4)
         ros2_control 块 = 硬件描述, 一机型一块 (2026-10-14 单块化定形: mujoco 插件按
         组件加载, 双块 = 双仿真实例抢进程单例, 实证 torso 组件找不到参数等话题
         120s 超时 → abort); js_arms/js_torso 编组归 controllers.yaml joints 显式列表
         限位/max_velocity 全程序化提取; ign 三件齐 (插件+gazebo块) -->
    <xacro:macro name="r1_pro_ros2_control" params="use_gazebo:=false headless:=true">
        <ros2_control name="r1_pro" type="system">
            <hardware>
                <xacro:if value="${use_gazebo == 'ign'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_gazebo == 'mujoco'}">
                    <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
                    <param name="mujoco_model">$(find unistackbot_description)/mobile_manipulators/r1_pro/mujoco/r1_pro.xml</param>
                    <param name="sim_speed_factor">1.0</param>
                    <!-- $(arg) 布尔坑: true 会变成 Python True, 归一回小写字符串 -->
                    <param name="headless">${'true' if headless in [True, 'true'] else 'false'}</param>
                </xacro:if>
                <xacro:unless value="${use_gazebo in ['ign', 'mujoco']}">
                    <plugin>unistackbot_sim_control/SimControlHardware</plugin>
                    <param name="backend">kinematic</param>
                </xacro:unless>
            </hardware>
            <xacro:macro name="r1_joint" params="name lo hi vmax:=2.5">
                <joint name="${name}">
                    <command_interface name="position"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                    <param name="min">${lo}</param>
                    <param name="max">${hi}</param>
                    <param name="max_velocity">${vmax}</param>
                </joint>
            </xacro:macro>
            <!-- 双臂 14 (7-DoF ×2) -->
            <xacro:r1_joint name="left_arm_joint1" lo="-4.4156934150" hi="1.2740934150" vmax="7.1209"/>
            <xacro:r1_joint name="left_arm_joint2" lo="-0.1395934150" hi="3.1066934150" vmax="7.1209"/>
            <xacro:r1_joint name="left_arm_joint3" lo="-2.3212894150" hi="2.3212894150" vmax="8.3776"/>
            <xacro:r1_joint name="left_arm_joint4" lo="-2.0594934150" hi="0.3141934150" vmax="8.3776"/>
            <xacro:r1_joint name="left_arm_joint5" lo="-2.3212894150" hi="2.3212894150" vmax="10.4720"/>
            <xacro:r1_joint name="left_arm_joint6" lo="-1.0122914150" hi="1.0122914150" vmax="10.4720"/>
            <xacro:r1_joint name="left_arm_joint7" lo="-1.5358934150" hi="1.5358934150" vmax="10.4720"/>
            <xacro:r1_joint name="right_arm_joint1" lo="-4.4156934150" hi="1.2740934150" vmax="7.1209"/>
            <xacro:r1_joint name="right_arm_joint2" lo="-3.1066934150" hi="0.1395934150" vmax="7.1209"/>
            <xacro:r1_joint name="right_arm_joint3" lo="-2.3212894150" hi="2.3212894150" vmax="8.3776"/>
            <xacro:r1_joint name="right_arm_joint4" lo="-2.0594934150" hi="0.3141934150" vmax="8.3776"/>
            <xacro:r1_joint name="right_arm_joint5" lo="-2.3212894150" hi="2.3212894150" vmax="10.4720"/>
            <xacro:r1_joint name="right_arm_joint6" lo="-1.0122914150" hi="1.0122914150" vmax="10.4720"/>
            <xacro:r1_joint name="right_arm_joint7" lo="-1.5358934150" hi="1.5358934150" vmax="10.4720"/>
            <!-- 腰 4 -->
            <xacro:r1_joint name="torso_joint1" lo="-1.2735467075" hi="1.8125467075"/>
            <xacro:r1_joint name="torso_joint2" lo="-2.6703467075" hi="2.6825467075"/>
            <xacro:r1_joint name="torso_joint3" lo="-1.7095467075" hi="1.5358467075"/>
            <xacro:r1_joint name="torso_joint4" lo="-3.0193934150" hi="3.0193934150"/>
            <!-- 轮系 6 (仅 gz/mujoco 链, 与 body 轮 link 同条件; steer=position 归
                 BaseVelocityController, yaml joints 显式列表不含它 = JS 不认领) -->
            <xacro:if value="${use_gazebo in ['ign', 'mujoco']}">
                <xacro:macro name="r1_wheel_joint" params="idx">
                    <joint name="steer_motor_joint${idx}">
                        <command_interface name="position"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                        <param name="min">-3.14</param>
                        <param name="max">3.14</param>
                        <param name="max_velocity">6.0</param>
                    </joint>
                    <joint name="wheel_motor_joint${idx}">
                        <command_interface name="velocity"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                    </joint>
                </xacro:macro>
                <xacro:r1_wheel_joint idx="1"/>
                <xacro:r1_wheel_joint idx="2"/>
                <xacro:r1_wheel_joint idx="3"/>
            </xacro:if>
        </ros2_control>

        <!-- Gazebo 侧系统插件 (ign 三件之二; 三 = 易冻关节 initial_value, 指纹后按需) -->
        <xacro:if value="${use_gazebo == 'ign'}">
            <gazebo>
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <robot_param>robot_description</robot_param>
                    <robot_param_node>robot_state_publisher</robot_param_node>
                    <parameters>$(find unistackbot_bringup)/config/r1_pro_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>
    </xacro:macro>
</robot>
