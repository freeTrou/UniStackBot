<mujoco model="xarm7">
  <!--
    xarm7 MuJoCo 模型 (2026-09-21), 管线同 piper (arms/piper/mujoco/README.md):
    robot_description_to_mjcf 从 URDF 转换身体树/惯量/限位/关节动力学
    (damping 10/5/2 与 frictionloss 1 来自 URDF <dynamics> 厂商值), 手工策展
    mesh 换 STL + 场景并入。xarm7 无 mimic 关节 (裸臂, end_tool 在上游宏中
    本就注释未接线), 无需 equality。

    增益: kp 按连杆质量 (2.4→0.17 kg) 与 effort 限 (50/30/20 N·m) 起步,
    离线验证零位下垂/阶跃后定稿; actuatorfrcrange 由转换器按 URDF effort 生成。
  -->
  <compiler angle="radian" meshdir="../meshes"/>

  <asset>
    <mesh name="link_base" file="xarm7/collision/link_base.stl"/>
    <mesh name="link1" file="xarm7/collision/link1.stl"/>
    <mesh name="link2" file="xarm7/collision/link2.stl"/>
    <mesh name="link3" file="xarm7/collision/link3.stl"/>
    <mesh name="link4" file="xarm7/collision/link4.stl"/>
    <mesh name="link5" file="xarm7/collision/link5.stl"/>
    <mesh name="link6" file="xarm7/collision/link6.stl"/>
    <mesh name="link7" file="xarm7/collision/link7.stl"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom conaffinity="0" contype="1" material="groundplane" name="floor" pos="0 0 -0.01" size="0 0 0.01" type="plane"/>

    <body name="link_base">
      <geom name="link_base_visual" mesh="link_base" class="visual"/>
      <geom name="link_base_collision" mesh="link_base" class="collision"/>
    </body>
    <body name="link1" pos="0 0 0.267">
      <inertial pos="-0.0002 0.02905 -0.01233" quat="0.978953 -0.202769 -0.00441617 -0.0227264" mass="2.382" diaginertia="0.00569127 0.00533384 0.00293865"/>
      <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-50 50" damping="10" frictionloss="1"/>
      <geom name="link1_visual" mesh="link1" class="visual"/>
      <geom name="link1_collision" mesh="link1" class="collision"/>
      <body name="link2" quat="0.707105 -0.707108 0 0">
        <inertial pos="0.00022 -0.12856 0.01735" quat="0.50198 0.86483 -0.00778841 0.00483285" mass="1.869" diaginertia="0.00959898 0.00937717 0.00201315"/>
        <joint name="joint2" pos="0 0 0" axis="0 0 1" range="-2.059 2.0944" actuatorfrcrange="-50 50" damping="10" frictionloss="1"/>
        <geom name="link2_visual" mesh="link2" class="visual"/>
        <geom name="link2_collision" mesh="link2" class="collision"/>
        <body name="link3" pos="0 -0.293 0" quat="0.707105 0.707108 0 0">
          <inertial pos="0.0466 -0.02463 -0.00768" quat="0.913819 0.289775 0.281481 -0.0416455" mass="1.6383" diaginertia="0.00351721 0.00294089 0.00195868"/>
          <joint name="joint3" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-30 30" damping="5" frictionloss="1"/>
          <geom name="link3_visual" mesh="link3" class="visual"/>
          <geom name="link3_collision" mesh="link3" class="collision"/>
          <body name="link4" pos="0.0525 0 0" quat="0.707105 0.707108 0 0">
            <inertial pos="0.07047 -0.11575 0.012" quat="0.422108 0.852026 -0.126025 0.282832" mass="1.7269" diaginertia="0.00657137 0.00647948 0.00186763"/>
            <joint name="joint4" pos="0 0 0" axis="0 0 1" range="-0.19198 3.927" actuatorfrcrange="-30 30" damping="5" frictionloss="1"/>
            <geom name="link4_visual" mesh="link4" class="visual"/>
            <geom name="link4_collision" mesh="link4" class="collision"/>
            <body name="link5" pos="0.0775 -0.3425 0" quat="0.707105 0.707108 0 0">
              <inertial pos="-0.00032 0.01604 -0.026" quat="0.999311 -0.0304457 0.000577067 0.0212082" mass="1.3203" diaginertia="0.00534729 0.00499076 0.0013489"/>
              <joint name="joint5" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-30 30" damping="5" frictionloss="1"/>
              <geom name="link5_visual" mesh="link5" class="visual"/>
              <geom name="link5_collision" mesh="link5" class="collision"/>
              <body name="link6" quat="0.707105 0.707108 0 0">
                <inertial pos="0.06469 0.03278 0.02141" quat="-0.217672 0.772419 0.16258 0.574069" mass="1.325" diaginertia="0.00245421 0.00221646 0.00107273"/>
                <joint name="joint6" pos="0 0 0" axis="0 0 1" range="-1.69297 3.14159" actuatorfrcrange="-20 20" damping="2" frictionloss="1"/>
                <geom name="link6_visual" mesh="link6" class="visual"/>
                <geom name="link6_collision" mesh="link6" class="collision"/>
                <body name="link7" pos="0.076 0.097 0" quat="0.707105 -0.707108 0 0">
                  <inertial pos="0 -0.00677 -0.01098" quat="0.487612 0.512088 -0.512088 0.487612" mass="0.17" diaginertia="0.000132176 9.3e-05 5.85236e-05"/>
                  <joint name="joint7" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-20 20" damping="2" frictionloss="1"/>
                  <geom name="link7_visual" mesh="link7" class="visual"/>
                  <geom name="link7_collision" mesh="link7" class="collision"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <option integrator="implicitfast"/>

  <statistic center="0.3 0 0.4" extent="1.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="visual">
      <geom group="2" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>
  </default>

  <actuator>
    <position name="joint1" joint="joint1" kp="15000" dampratio="1.0" ctrlrange="-6.2831853 6.2831853"/>
    <position name="joint2" joint="joint2" kp="15000" dampratio="1.0" ctrlrange="-2.059 2.0944"/>
    <position name="joint3" joint="joint3" kp="8000" dampratio="1.0" ctrlrange="-6.2831853 6.2831853"/>
    <position name="joint4" joint="joint4" kp="5000" dampratio="1.0" ctrlrange="-0.19198 3.927"/>
    <position name="joint5" joint="joint5" kp="3000" dampratio="1.0" ctrlrange="-6.2831853 6.2831853"/>
    <position name="joint6" joint="joint6" kp="2000" dampratio="1.0" ctrlrange="-1.69297 3.1415926"/>
    <position name="joint7" joint="joint7" kp="1000" dampratio="1.0" ctrlrange="-6.2831853 6.2831853"/>
  </actuator>
</mujoco>
