<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="xarm7_ros2_control" params="use_gazebo:=false headless:=true">

        <ros2_control name="xarm7_system" type="system">

            <hardware>
                <!-- use_gazebo: 'ign'=Gazebo Sim(Fortress), 'mujoco'=MuJoCo(mujoco_ros2_control),
                     'true'/'classic'=Gazebo Classic, 其余=mock 插件.
                     注意: $(arg) 传参时 xacro 会把 true/false 解析成 Python 布尔, 条件需同时匹配 True -->
                <xacro:if value="${use_gazebo == 'ign'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_gazebo == 'mujoco'}">
                    <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
                    <!-- MJCF 资产: 身体树由本 URDF 转换 + 手工策展, 见 arms/xarm7/mujoco/README.md -->
                    <param name="mujoco_model">$(find unistackbot_description)/arms/xarm7/mujoco/xarm7.xml</param>
                    <param name="sim_speed_factor">1.0</param>
                    <!-- $(arg) 布尔坑: true 会变成 Python True, 归一回小写字符串 -->
                    <param name="headless">${'true' if headless in [True, 'true'] else 'false'}</param>
                </xacro:if>
                <xacro:if value="${use_gazebo in [True, 'true', 'classic']}">
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_gazebo in ['ign', 'mujoco', True, 'true', 'classic']}">
                    <plugin>unistackbot_sim_control/SimControlHardware</plugin>
                    <param name="backend">kinematic</param>
                </xacro:unless>
                <!-- 实机 device/baudrate 参数随总线选型(D-B)落地时补, 与 piper 的 CAN 占位同型 -->
                <param name="loop_rate">500</param>
            </hardware>

            <!-- 限位与上游 xarm7_macro.xacro 的 URDF 标称值一致; max_velocity 取 URDF velocity 限值 -->
            <joint name="joint1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-6.2831853</param>
                <param name="max">6.2831853</param>
                <param name="max_velocity">3.14</param>
            </joint>

            <joint name="joint2">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-2.059</param>
                <param name="max">2.0944</param>
                <param name="max_velocity">3.14</param>
            </joint>

            <joint name="joint3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-6.2831853</param>
                <param name="max">6.2831853</param>
                <param name="max_velocity">3.14</param>
            </joint>

            <joint name="joint4">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-0.19198</param>
                <param name="max">3.927</param>
                <param name="max_velocity">3.14</param>
            </joint>

            <joint name="joint5">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-6.2831853</param>
                <param name="max">6.2831853</param>
                <param name="max_velocity">3.14</param>
            </joint>

            <joint name="joint6">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-1.69297</param>
                <param name="max">3.1415926</param>
                <param name="max_velocity">3.14</param>
            </joint>

            <joint name="joint7">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-6.2831853</param>
                <param name="max">6.2831853</param>
                <param name="max_velocity">3.14</param>
            </joint>

        </ros2_control>

        <!-- Gazebo 侧系统插件: 与上方 use_gazebo 模式对应, 控制器配置共用 bringup 的 yaml -->
        <xacro:if value="${use_gazebo in [True, 'true', 'classic']}">
            <gazebo>
                <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
                    <parameters>$(find unistackbot_bringup)/config/xarm7_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>
        <xacro:if value="${use_gazebo == 'ign'}">
            <gazebo>
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <robot_param>robot_description</robot_param>
                    <robot_param_node>robot_state_publisher</robot_param_node>
                    <parameters>$(find unistackbot_bringup)/config/xarm7_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>

    </xacro:macro>

</robot>
