<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumos Station Lite dual-arm URDF.
  The arm inertial and mass values are retained from the original single-arm export.
  New base and camera inertial properties are intentionally deferred.
-->
<robot name="stationlite">
  <material name="station_gray">
    <color rgba="0.75294 0.75294 0.75294 1" />
  </material>

  <!-- Root frame: coincides with the world frame when spawned at zero pose. -->
  <link name="base">
    <inertial>
      <origin xyz="-0.008088 -0.000003 0.217476" rpy="0 0 0" />
      <mass value="2.239" />
      <inertia
        ixx="0.265323119"
        ixy="-0.000000063"
        ixz="0.004959622"
        iyy="0.217350657"
        iyz="-0.000001195"
        izz="0.049509934" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://stationlite/meshes/base.STL" />
      </geometry>
      <material name="station_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://stationlite/meshes/base.STL" />
      </geometry>
    </collision>
  </link>

