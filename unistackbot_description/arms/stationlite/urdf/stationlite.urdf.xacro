<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stationlite">

    <xacro:arg name="use_ros2_control" default="false" />
    <xacro:arg name="use_world" default="true" />
    <xacro:arg name="use_gazebo" default="false" />
    <xacro:arg name="headless" default="true" />

    <xacro:include filename="$(find unistackbot_description)/arms/stationlite/urdf/stationlite_macro.xacro"/>
    <xacro:include filename="$(find unistackbot_description)/arms/stationlite/urdf/stationlite_ros2_control.xacro"/>

    <xacro:if value="$(arg use_world)">
        <link name="world"/>
        <joint name="stationlite_world" type="fixed">
            <parent link="world"/>
            <child link="base"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>
    </xacro:if>

    <xacro:stationlite_dual_arm/>

    <xacro:if value="$(arg use_ros2_control)">
        <xacro:stationlite_ros2_control use_gazebo="$(arg use_gazebo)"/>
    </xacro:if>

</robot>
