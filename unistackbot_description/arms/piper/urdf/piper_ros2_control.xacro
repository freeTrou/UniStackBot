<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="piper_ros2_control" params="use_gripper:=true use_gazebo:=false headless:=true">

        <ros2_control name="piper_system" type="system">

            <hardware>
                <!-- use_gazebo: 'ign'=Gazebo Sim(Fortress), 'mujoco'=MuJoCo(mujoco_ros2_control),
                     'true'/'classic'=Gazebo Classic, 其余=mock 插件.
                     注意: $(arg) 传参时 xacro 会把 true/false 解析成 Python 布尔, 条件需同时匹配 True -->
                <xacro:if value="${use_gazebo == 'ign'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_gazebo == 'mujoco'}">
                    <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
                    <!-- MJCF 资产: 身体树由本 URDF 转换 + 手工策展, 见 arms/piper/mujoco/README.md -->
                    <param name="mujoco_model">$(find unistackbot_description)/arms/piper/mujoco/piper.xml</param>
                    <param name="sim_speed_factor">1.0</param>
                    <!-- $(arg) 布尔坑: true 会变成 Python True, 归一回小写字符串 -->
                    <param name="headless">${'true' if headless in [True, 'true'] else 'false'}</param>
                </xacro:if>
                <xacro:if value="${use_gazebo in [True, 'true', 'classic']}">
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_gazebo in ['ign', 'mujoco', True, 'true', 'classic']}">
                    <plugin>unistackbot_sim_control/SimControlHardware</plugin>
                    <param name="backend">kinematic</param>
                </xacro:unless>
                <param name="device">/dev/piper_arm</param>
                <param name="baudrate">2000000</param>
                <param name="loop_rate">500</param>
            </hardware>

            <joint name="joint1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-2.6179938</param>
                <param name="max">2.6179938</param>
                    <param name="max_velocity">5.0</param>
            </joint>

            <joint name="joint2">
                <command_interface name="position"/>
                <!-- gz/ODE 已知行为 (上游 gz_ros2_control issue #165): 关节静置恰好压在限位上会被
                     限位约束咬死, 无法再命令离开 (捕获区微米级, 官方 demo 用 initial_value 规避)。
                     本关节限位 0..3.14, 启动位 0=下限, 故 ign 链启动即抬 0.01 rad -->
                <xacro:if value="${use_gazebo == 'ign'}">
                    <state_interface name="position">
                        <param name="initial_value">0.01</param>
                    </state_interface>
                </xacro:if>
                <xacro:unless value="${use_gazebo == 'ign'}">
                    <state_interface name="position"/>
                </xacro:unless>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">0</param>
                <param name="max">3.1415926</param>
                    <param name="max_velocity">5.0</param>
            </joint>

            <joint name="joint3">
                <command_interface name="position"/>
                <!-- 同 joint2: 限位 -2.97..0, 启动位 0=上限, ign 链启动即压 -0.01 rad 离开限位线 -->
                <xacro:if value="${use_gazebo == 'ign'}">
                    <state_interface name="position">
                        <param name="initial_value">-0.01</param>
                    </state_interface>
                </xacro:if>
                <xacro:unless value="${use_gazebo == 'ign'}">
                    <state_interface name="position"/>
                </xacro:unless>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-2.9670597</param>
                <param name="max">0</param>
                    <param name="max_velocity">5.0</param>
            </joint>

            <joint name="joint4">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-1.7453292</param>
                <param name="max">1.7453292</param>
                    <param name="max_velocity">5.0</param>
            </joint>

            <joint name="joint5">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-1.2217304</param>
                <param name="max">1.2217304</param>
                    <param name="max_velocity">5.0</param>
            </joint>

            <joint name="joint6">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-2.0943951</param>
                <param name="max">2.0943951</param>
                    <param name="max_velocity">5.0</param>
            </joint>

            <xacro:if value="${use_gripper}">
                <joint name="gripper">
                    <command_interface name="position"/>
                    <!-- 同 joint2: 限位 0..0.1, 启动位 0=下限, ign 链启动即张 0.001 m (1mm/全程100mm) -->
                    <xacro:if value="${use_gazebo == 'ign'}">
                        <state_interface name="position">
                            <param name="initial_value">0.001</param>
                        </state_interface>
                    </xacro:if>
                    <xacro:unless value="${use_gazebo == 'ign'}">
                        <state_interface name="position"/>
                    </xacro:unless>
                    <state_interface name="velocity"/>
                    <param name="min">0</param>
                    <param name="max">0.1</param>
                    <param name="max_velocity">3.0</param>
                </joint>
                <!-- 两个 mimic 手指关节, 按链分流:
                     mujoco/ign: passive —— 无 command_interface。mujoco: 跟随由 MJCF equality 承担
                       (见 mujoco/README.md)。ign: 插件 mimic 只认 ros2_control 块 mimic/multiplier
                       参数 (0.7.20/0.7.21 相同), URDF <mimic> 标签被 sdformat 转换丢弃 —— 手指实为
                       自由关节, 已知漂移; 加 mimic 参数可获插件内 P 驱动耦合, 但接口会带 _mimic 后缀
                       污染 /joint_states 关节名, 耦合方案待裁决 (独立工作项)。
                       JointStream 解析后只管 7 个主关节。
                     mock/Classic: 按 gazebo_ros2_control 要求补 mimic/multiplier 参数受控跟随 -->
                <xacro:if value="${use_gazebo in ['mujoco', 'ign']}">
                    <joint name="gripper_joint1">
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                    </joint>
                    <joint name="gripper_joint2">
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                    </joint>
                </xacro:if>
                <xacro:unless value="${use_gazebo in ['mujoco', 'ign']}">
                    <joint name="gripper_joint1">
                        <command_interface name="position"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                        <param name="mimic">gripper</param>
                        <param name="multiplier">0.5</param>
                        <param name="offset">0.0</param>
                    </joint>
                    <joint name="gripper_joint2">
                        <command_interface name="position"/>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                        <param name="mimic">gripper</param>
                        <param name="multiplier">-0.5</param>
                        <param name="offset">0.0</param>
                    </joint>
                </xacro:unless>
            </xacro:if>

        </ros2_control>

        <!-- Gazebo 侧系统插件: 与上方 use_gazebo 模式对应, 控制器配置共用 bringup 的 yaml -->
        <xacro:if value="${use_gazebo in [True, 'true', 'classic']}">
            <gazebo>
                <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
                    <parameters>$(find unistackbot_bringup)/config/piper_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>
        <xacro:if value="${use_gazebo == 'ign'}">
            <gazebo>
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <robot_param>robot_description</robot_param>
                    <robot_param_node>robot_state_publisher</robot_param_node>
                    <parameters>$(find unistackbot_bringup)/config/piper_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>

    </xacro:macro>

</robot>
