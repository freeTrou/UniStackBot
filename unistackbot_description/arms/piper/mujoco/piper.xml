<mujoco model="piper">
  <!--
    piper MuJoCo 模型 (阶段1 MuJoCo 链资产, 2026-09-20)。

    生成方式: mujoco_ros2_control 的 robot_description_to_mjcf 从 piper URDF 转换出
    身体树/惯量/关节限位, 再手工策展:
      - mesh 换用仓库自带 collision STL (MuJoCo 原生支持, meshdir 相对指到
        ../meshes/collision/ — 几何单一事实源, 不复制 OBJ 资产; OBJ 美化留作后续)
      - 场景 (地板/灯光/statistic) 并入单文件
      - 执行器/equality 来自同目录 piper_inputs.xml
    再生命令 (URDF 改动后): 见同目录 README.md。

    约定 (对齐 mujoco_ros2_control 0.1.2):
      - position 执行器 name == joint name (插件按名映射)
      - mimic 手指: gripper 主关节带执行器, 两手指 passive + equality 耦合
        (URDF mimic: gripper_joint1 = 0.5*gripper, gripper_joint2 = -0.5*gripper);
        ros2_control 侧手指无 command_interface → JointStream 自动只管 7 个主关节
      - timestep 默认 0.002 (500Hz) 与控制器 update_rate 对齐
      - kp/dampratio 为 piper 量级起步值 (连杆 0.4-1.2kg), 首跑后按跟踪调
  -->
  <compiler angle="radian" meshdir="../meshes/collision/"/>

  <asset>
    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="link1" file="link1.stl"/>
    <mesh name="link2" file="link2.stl"/>
    <mesh name="link3" file="link3.stl"/>
    <mesh name="link4" file="link4.stl"/>
    <mesh name="link5" file="link5.stl"/>
    <mesh name="link6" file="link6.stl"/>
    <mesh name="flange" file="flange.stl"/>
    <mesh name="gripper_base" file="gripper_base.stl"/>
    <mesh name="gripper_link1" file="gripper_link1.stl"/>
    <mesh name="gripper_link2" file="gripper_link2.stl"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom conaffinity="0" contype="1" material="groundplane" name="floor" pos="0 0 -0.01" size="0 0 0.01" type="plane"/>

    <body name="base_link">
      <geom name="base_link_visual" mesh="base_link" class="visual"/>
      <geom name="base_link_collision" mesh="base_link" class="collision"/>
    </body>
    <body name="link1" pos="0 0 0.123">
      <inertial pos="0.00032 -0.00041 -0.00348" quat="0.737007 0.671914 -0.0484837 0.0547877" mass="0.71" diaginertia="0.0005012 0.00045752 0.00040836"/>
      <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-2.61799 2.61799" actuatorfrcrange="-100 100" damping="0.1" frictionloss="0.1"/>
      <geom name="link1_visual" mesh="link1" class="visual"/>
      <geom name="link1_collision" mesh="link1" class="collision"/>
      <body name="link2" quat="0.047971 -0.0479709 -0.705478 -0.705478">
        <inertial pos="0.21852 -0.00861 0.00126" quat="0.479919 0.532436 0.466857 0.517913" mass="1.16" diaginertia="0.0676841 0.0675582 0.00106833"/>
        <joint name="joint2" pos="0 0 0" axis="0 0 1" range="0 3.14159" actuatorfrcrange="-100 100" damping="0.1" frictionloss="0.1"/>
        <geom name="link2_visual" mesh="link2" class="visual"/>
        <geom name="link2_collision" mesh="link2" class="collision"/>
        <body name="link3" pos="0.28503 0 0" quat="0.624016 0 0 -0.781412">
          <inertial pos="-0.01999 -0.14808 -0.00053" quat="0.70534 0.70619 0.0352022 0.0505251" mass="0.5" diaginertia="0.0136724 0.0136332 0.000267444"/>
          <joint name="joint3" pos="0 0 0" axis="0 0 1" range="-2.96706 0" actuatorfrcrange="-100 100" damping="0.1" frictionloss="0.1"/>
          <geom name="link3_visual" mesh="link3" class="visual"/>
          <geom name="link3_collision" mesh="link3" class="collision"/>
          <body name="link4" pos="-0.02198 -0.25075 0" quat="0.707107 0.707107 0 0">
            <inertial pos="0.00013 -0.00076 -0.00394" quat="0.727848 0.0276487 -0.0387803 0.684082" mass="0.38" diaginertia="0.000189565 0.00017841 0.000145735"/>
            <joint name="joint4" pos="0 0 0" axis="0 0 1" range="-1.74533 1.74533" actuatorfrcrange="-100 100" damping="0.1" frictionloss="0.1"/>
            <geom name="link4_visual" mesh="link4" class="visual"/>
            <geom name="link4_collision" mesh="link4" class="collision"/>
            <body name="link5" quat="0.707107 -0.707107 0 0">
              <inertial pos="0.00018 -0.06104 -0.00227" quat="0.709375 0.704813 -0.00301298 0.00422225" mass="0.383" diaginertia="0.00172319 0.00171178 0.000179292"/>
              <joint name="joint5" pos="0 0 0" axis="0 0 1" range="-1.22173 1.22173" actuatorfrcrange="-100 100" damping="0.1" frictionloss="0.1"/>
              <geom name="link5_visual" mesh="link5" class="visual"/>
              <geom name="link5_collision" mesh="link5" class="collision"/>
              <body name="link6" pos="8.8259e-05 -0.091 0" quat="0.707107 0.707107 0 0">
                <inertial pos="-1.79581e-05 0.000136012 0.033536" quat="0.999994 0.000309365 0.000921194 0.00333002" mass="0.497" diaginertia="0.00250665 0.0021575 0.000725664"/>
                <joint name="joint6" pos="0 0 0" axis="0 0 1" range="-2.0944 2.0944" actuatorfrcrange="-100 100" damping="0.1" frictionloss="0.1"/>
                <geom name="link6_visual" mesh="link6" class="visual"/>
                <geom name="link6_collision" mesh="link6" class="collision"/>
                <geom name="flange_visual" mesh="flange" class="visual"/>
                <geom name="flange_collision" mesh="flange" class="collision"/>
                <geom name="gripper_base_visual" mesh="gripper_base" class="visual" pos="0 0 0.0045"/>
                <geom name="gripper_base_collision" mesh="gripper_base" class="collision" pos="0 0 0.0045"/>
                <body name="gripper_link" pos="0 0 0.0045">
                  <!-- URDF 惯量占位链接 (无几何); MuJoCo 要求惯量非零 -->
                  <inertial pos="0 0 0.01" mass="0.01" diaginertia="1e-06 1e-06 1e-06"/>
                  <joint name="gripper" pos="0 0 0" axis="0 0 1" type="slide" range="0 0.1" actuatorfrcrange="-10 10" damping="0.1" frictionloss="0.1"/>
                </body>
                <body name="gripper_link1" pos="0 0 0.1425" quat="0.707107 0.707107 0 0">
                  <inertial pos="0.000651232 -0.049193 0.00972259" quat="0.477798 0.572974 -0.518028 0.418398" mass="0.025" diaginertia="7.74531e-05 7.36783e-05 5.0886e-06"/>
                  <joint name="gripper_joint1" pos="0 0 0" axis="0 0 1" type="slide" range="0 0.05" actuatorfrcrange="-10 10" damping="0.1" frictionloss="0.1"/>
                  <geom name="gripper_link1_visual" mesh="gripper_link1" class="visual"/>
                  <geom name="gripper_link1_collision" mesh="gripper_link1" class="collision"/>
                </body>
                <body name="gripper_link2" pos="0 0 0.1425" quat="1.89469e-08 1.89469e-08 -0.707107 -0.707107">
                  <inertial pos="0.000651232 -0.049193 0.00972259" quat="0.477798 0.572974 -0.518028 0.418398" mass="0.025" diaginertia="7.74531e-05 7.36783e-05 5.0886e-06"/>
                  <joint name="gripper_joint2" pos="0 0 0" axis="0 0 -1" type="slide" range="-0.05 0" actuatorfrcrange="-10 10" damping="0.1" frictionloss="0.1"/>
                  <geom name="gripper_link2_visual" mesh="gripper_link2" class="visual"/>
                  <geom name="gripper_link2_collision" mesh="gripper_link2" class="collision"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <option integrator="implicitfast"/>

  <statistic center="0.2 0 0.3" extent="1"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <default class="visual">
      <geom group="2" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>
  </default>

  <actuator>
    <position name="joint1" joint="joint1" kp="1500" dampratio="1.0" ctrlrange="-2.6179938 2.6179938"/>
    <position name="joint2" joint="joint2" kp="1500" dampratio="1.0" ctrlrange="0 3.1415926"/>
    <position name="joint3" joint="joint3" kp="1000" dampratio="1.0" ctrlrange="-2.9670597 0"/>
    <position name="joint4" joint="joint4" kp="500" dampratio="1.0" ctrlrange="-1.7453292 1.7453292"/>
    <position name="joint5" joint="joint5" kp="300" dampratio="1.0" ctrlrange="-1.2217304 1.2217304"/>
    <position name="joint6" joint="joint6" kp="200" dampratio="1.0" ctrlrange="-2.0943951 2.0943951"/>
    <position name="gripper" joint="gripper" kp="200" dampratio="1.0" ctrlrange="0 0.1"/>
  </actuator>

  <!-- equality 方向 (MuJoCo 3.x 实测): 约束为 joint1 = poly(joint2) — 第一关节是因变量,
       与官方文档文字相反 (demo 的 polycoef=-1 自反故两向皆可, 未暴露); 详见同目录 README。
       目标关系 (URDF mimic): gj1 = 0.5*gripper, gj2 = -0.5*gripper → 主关节放 joint2。
       solimp/solref 取 demo 同款硬化参数 (默认软约束跟不满)。 -->
  <equality>
    <joint joint1="gripper_joint1" joint2="gripper" polycoef="0 0.5 0 0 0"
           solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="gripper_joint2" joint2="gripper" polycoef="0 -0.5 0 0 0"
           solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!-- 凸包接触排除: mesh 碰撞用凸包, 相邻件凸包互穿会卡死关节。
       base_link↔link1: 世界体-子体接触不被自动排除 (静态体不入父子过滤);
       gripper_link1↔gripper_link2: 兄弟体不在父子过滤内, 闭合位凸包相切。
       臂身串行链的父子对由 MuJoCo 自动过滤 (实测 qpos0 零接触)。 -->
  <contact>
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="gripper_link1" body2="gripper_link2"/>
  </contact>
</mujoco>
