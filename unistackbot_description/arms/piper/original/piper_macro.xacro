<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="piper_arm" params="parent:=base_link origin_xyz:='0 0 0' origin_rpy:='0 0 0'">

        <joint name="world_to_base_link" type="fixed">
            <parent link="${parent}"/>
            <child link="base_link"/>
            <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
        </joint>

        <link name="base_link">
            <inertial>
                <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016" rpy="0 0 0"/>
                <mass value="1.02" />
                <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/visual/base_link.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/collision/base_link.stl"/>
                </geometry>
            </collision>
        </link>

        <link name="link1">
            <inertial>
                <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0"/>
                <mass value="0.71"/>
                <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/visual/link1.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/collision/link1.stl"/>
                </geometry>
            </collision>
        </link>
        <joint name="joint1" type="revolute">
            <origin xyz="0 0 0.123" rpy="0 0 0"/>
            <parent link="base_link"/>
            <child link="link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link2">
            <inertial>
                <origin xyz="0.21852 -0.00861 0.00126" rpy="0 0 0"/>
                <mass value="1.16"/>
                <inertia ixx="0.00111915" ixy="0.00182916" ixz="0.00019233" iyy="0.06763251" iyz="0.00000767" izz="0.067559"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/visual/link2.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/collision/link2.stl"/>
                </geometry>
            </collision>
        </link>
        <joint name="joint2" type="revolute">
            <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/>
            <parent link="link1"/>
            <child link="link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link3">
            <inertial>
                <origin xyz="-0.01999 -0.14808 -0.00053" rpy="0 0 0"/>
                <mass value="0.5"/>
                <inertia ixx="0.01347608" ixy="0.00161034" ixz="0.00000066" iyy="0.00046377" iyz="0.00000162" izz="0.01363321"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/visual/link3.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/collision/link3.stl"/>
                </geometry>
            </collision>
        </link>
        <joint name="joint3" type="revolute">
            <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
            <parent link="link2"/>
            <child link="link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link4">
            <inertial>
                <origin xyz="0.00013 -0.00076 -0.00394" rpy="0 0 0"/>
                <mass value="0.38"/>
                <inertia ixx="0.00017844" ixy="0.00000062" ixz="0.00000067" iyy="0.00018914" iyz="0.00000408" izz="0.00014613"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/visual/link4.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/collision/link4.stl"/>
                </geometry>
            </collision>
        </link>
        <joint name="joint4" type="revolute">
            <origin xyz="-0.02198 -0.25075 0" rpy="1.5707963 0 0"/>
            <parent link="link3"/>
            <child link="link4"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.7453292" upper="1.7453292" effort="100" velocity="5"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link5">
            <inertial>
                <origin xyz="0.00018 -0.06104 -0.00227" rpy="0 0 0"/>
                <mass value="0.383"/>
                <inertia ixx="0.00172318" ixy="0.00000259" ixz="0.00000010" iyy="0.00017936" iyz="0.00000990" izz="0.00171172"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/visual/link5.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/collision/link5.stl"/>
                </geometry>
            </collision>
        </link>
        <joint name="joint5" type="revolute">
            <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
            <parent link="link4"/>
            <child link="link5"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.2217304" upper="1.2217304" effort="100" velocity="5"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

        <link name="link6">
            <inertial>
                <origin xyz="-0.00003 0.00006 -0.002" rpy="0 0 0"/>
                <mass value="0.007"/>
                <inertia ixx="0.00152112" ixy="0.00000202" ixz="0.00000261" iyy="0.00138626" iyz="0.00000002" izz="0.00031152"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/visual/link6.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://unistackbot_description/arms/piper/meshes/collision/link6.stl"/>
                </geometry>
            </collision>
        </link>
        <joint name="joint6" type="revolute">
            <origin xyz="8.8259E-05 -0.091 0" rpy="1.5707963 0 0"/>
            <parent link="link5"/>
            <child link="link6"/>
            <axis xyz="0 0 1"/>
            <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>

    </xacro:macro>

</robot>
