       纪律全部来自 stationlite 调修档案 (arms/stationlite/mujoco/README.md):
       joint pos=0 + 挂 child body (URDF 轴过 child 原点) / default 类 type="mesh"
       / 全关节 damping+frictionloss+actuatorfrcrange / ts 0.001 / 起步 kp 低档
       零位压限位线 (J2/J4 下限=0) 已知, 先直接跑有抖动再按 #5 调 -->
  <compiler angle="radian" meshdir="../meshes/visual/"/>
  <option timestep="0.001"/>
  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="Link1" file="Link1.STL"/>
