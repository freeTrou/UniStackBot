<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- r1_7a ros2_control 块: J1-J7 position 命令接口 (仿真链 CSP); 分支同 piper 范本:
         ign=GazeboSimSystem / mujoco=mujoco_ros2_control / 其余=SimControlHardware kinematic。
         ign 分支 J2/J4 initial_value: gz/ODE 限位咬死坑 (上游 gz_ros2_control issue #165,
         piper joint2 同款) —— J2/J4 限位 0..π 启动位 0=下限, ign 链启动即抬 0.01 rad -->
    <xacro:macro name="r1_7a_ros2_control" params="use_gazebo:=false headless:=true">
        <ros2_control name="r1_7a" type="system">
            <hardware>
                <xacro:if value="${use_gazebo == 'ign'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_gazebo == 'mujoco'}">
                    <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
                    <param name="mujoco_model">$(find unistackbot_description)/arms/r1_7a/mujoco/r1_7a.xml</param>
                    <param name="sim_speed_factor">1.0</param>
                    <!-- 节拍账 (2026-10-12 排查, 保持 1.0 裁决): 上游主循环 60fps-sleep 结构
                         每步睡过头 ~73µs + 偶发超支 → 补步 → update sim 域 6.9% 相位错动 (3ms 插入)。
                         不取 <1 的原因: ①训练管线 uniform resample 面前错动零影响 ②RTF<1 伤
                         遥操手感/吞吐/历史基线一致性 ③墙钟稳定两值都不达标, 根治=上游 PR #47。
                         消费纪律: 外部按 stamp 对齐, dt 用 stamp 差分自算 -->
                    <param name="headless">${'true' if headless in [True, 'true'] else 'false'}</param>
                </xacro:if>
                <xacro:unless value="${use_gazebo in ['ign', 'mujoco']}">
                    <plugin>unistackbot_sim_control/SimControlHardware</plugin>
                    <param name="backend">kinematic</param>
                </xacro:unless>
            </hardware>
            <joint name="J1">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-2.723</param>
                <param name="max">2.723</param>
                <param name="max_velocity">18.7</param>
            </joint>
            <joint name="J2">
                <command_interface name="position"/>
                <!-- gz/ODE 限位咬死坑 (piper joint2 同款): 限位 0..π 启动位 0=下限,
                     ign 链启动即抬 0.01 rad 离开限位线 -->
                <xacro:if value="${use_gazebo == 'ign'}">
                    <state_interface name="position">
                        <param name="initial_value">0.01</param>
                    </state_interface>
                </xacro:if>
                <xacro:unless value="${use_gazebo == 'ign'}">
                    <state_interface name="position"/>
                </xacro:unless>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">0</param>
                <param name="max">3.1416</param>
                <param name="max_velocity">18.7</param>
            </joint>
            <joint name="J3">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-0.349</param>
                <param name="max">3.491</param>
                <param name="max_velocity">33.4</param>
            </joint>
            <joint name="J4">
                <command_interface name="position"/>
                <!-- 同 J2: 限位 0..π 启动位 0=下限, ign 链抬 0.01 rad -->
                <xacro:if value="${use_gazebo == 'ign'}">
                    <state_interface name="position">
                        <param name="initial_value">0.01</param>
                    </state_interface>
                </xacro:if>
                <xacro:unless value="${use_gazebo == 'ign'}">
                    <state_interface name="position"/>
                </xacro:unless>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">0</param>
                <param name="max">3.1415</param>
                <param name="max_velocity">33.4</param>
            </joint>
            <joint name="J5">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-2.269</param>
                <param name="max">2.269</param>
                <param name="max_velocity">33.4</param>
            </joint>
            <joint name="J6">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-0.524</param>
                <param name="max">0.524</param>
                <param name="max_velocity">37.7</param>
            </joint>
            <joint name="J7">
                <command_interface name="position"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="min">-1.571</param>
                <param name="max">1.571</param>
                <param name="max_velocity">37.7</param>
            </joint>
        </ros2_control>
        <!-- Gazebo 侧系统插件 (piper 同款): gz server 加载 gz_ros2_control-system 并
             用本 yaml 建 CM —— 缺此块时 hardware plugin 声明再多 CM 也不会出生 -->
        <xacro:if value="${use_gazebo == 'ign'}">
            <gazebo>
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <robot_param>robot_description</robot_param>
                    <robot_param_node>robot_state_publisher</robot_param_node>
                    <parameters>$(find unistackbot_bringup)/config/r1_7a_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>
    </xacro:macro>
</robot>
