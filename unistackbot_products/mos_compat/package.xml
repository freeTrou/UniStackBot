<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mos_compat</name>
  <version>0.1.0</version>
  <description>MOS 对外接口兼容门面 (Phase 2): /sdk ROS 面 → UniStackBot 控制器翻译层。46 方法中的手臂子集先行 (sdk/arm/joint_servo + cartesian_servo + set_control_mode + status)。</description>
  <maintainer email="todo@todo.todo">UniStackBot</maintainer>
  <license>TODO: Declaration of license</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>unistackbot_interface</depend>

  <exec_depend>unistackbot_controller</exec_depend>
  <exec_depend>unistackbot_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
