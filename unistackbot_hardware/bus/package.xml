<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unistackbot_bus</name>
  <version>0.0.1</version>
  <description>总线主站轴: MasterBase 父类 (纯交换语义零线程可见) + 工厂。交换类型自持零 ROS (BusCommand/BusState = protocol Node 类型定长数组)。子类 SerialMaster 随串口泵骨架落地注册。</description>
  <maintainer email="todo@todo.todo">UniStackBot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>unistackbot_protocol</depend>
  <depend>unistackbot_statemachine</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
