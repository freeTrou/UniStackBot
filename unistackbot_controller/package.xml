<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unistackbot_controller</name>
  <version>0.1.0</version>
  <description>控制器集成包：笛卡尔流式运动控制器（CM 插件）+ IK 工具与演示节点。算法库见 unistackbot_algorithm。</description>
  <maintainer email="todo@todo.todo">UniStackBot</maintainer>
  <license>TODO: Declaration of license</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>controller_interface</depend>
  <depend>realtime_tools</depend>
  <depend>pluginlib</depend>
  <depend>ament_index_cpp</depend>
  <depend>tinyxml2_vendor</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>unistackbot_interface</depend>
  <depend>unistackbot_algorithm</depend>
  <depend>interactive_markers</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- pluginlib 发现走 package.xml export (与 sim_control 同款机制); 路径相对包 share 根 -->
    <pluginlib plugin="cartesian_motion_controller/cartesian_motion_controller.xml" />
    <pluginlib plugin="joint_stream_controller/joint_stream_controller.xml" />
    <pluginlib plugin="ee_state_broadcaster/ee_state_broadcaster.xml" />
  </export>
</package>
